<Window x:Class="DrawingComparator.App.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exporter PNG"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushTextPrimary}"
        WindowStyle="ToolWindow">
    <StackPanel Margin="{StaticResource SpaceL}">
        <TextBlock Text="ZONE" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />
        <RadioButton x:Name="FullSheetRadio"
                     Content="Feuille entière"
                     IsChecked="True"
                     GroupName="Zone"
                     Foreground="{StaticResource BrushTextPrimary}" />
        <RadioButton x:Name="CurrentViewRadio"
                     Content="Vue courante (ce qui est à l'écran)"
                     GroupName="Zone"
                     Margin="0,4,0,0"
                     Foreground="{StaticResource BrushTextPrimary}" />

        <TextBlock Text="RÉSOLUTION" Style="{StaticResource PanelTitle}" Margin="0,16,0,8" />
        <StackPanel x:Name="DpiPanel" IsEnabled="{Binding IsChecked, ElementName=FullSheetRadio}">
            <RadioButton x:Name="Dpi150Radio"
                         Content="150 DPI — partage et revue"
                         IsChecked="True"
                         GroupName="Dpi"
                         Foreground="{StaticResource BrushTextPrimary}" />
            <RadioButton x:Name="Dpi300Radio"
                         Content="300 DPI — archivage haute définition"
                         GroupName="Dpi"
                         Margin="0,4,0,0"
                         Foreground="{StaticResource BrushTextPrimary}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annuler" MinWidth="88" MinHeight="32" Click="OnCancel" />
            <Button Content="Exporter…"
                    MinWidth="88"
                    MinHeight="32"
                    Margin="8,0,0,0"
                    Background="{StaticResource BrushAccent}"
                    Foreground="{StaticResource BrushAccentText}"
                    Click="OnExport" />
        </StackPanel>
    </StackPanel>
</Window>
