<ui:FluentWindow x:Class="DrawingComparator.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:DrawingComparator.App.Views"
                 xmlns:vm="clr-namespace:DrawingComparator.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="DrawingComparator"
                 Width="1280"
                 Height="800"
                 MinWidth="1000"
                 MinHeight="640"
                 Background="{StaticResource BrushBackground}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.InputBindings>
        <!-- Ctrl+O unique : projet .dcproj OU plan PDF (DESIGN_PLAN §11.1) -->
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenAnyCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="O" Command="{Binding OpenRevisionCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding ExportCommand}" />
        <KeyBinding Key="A" Command="{Binding StartAlignmentCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelAlignmentCommand}" />
        <KeyBinding Key="Back" Command="{Binding UndoAlignmentPointCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <Style x:Key="LayerCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
            <Setter Property="Padding" Value="{StaticResource SpaceM}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
            <Setter Property="Foreground" Value="{StaticResource BrushAccentText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DropCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
            <Setter Property="Padding" Value="{StaticResource SpaceL}" />
            <Setter Property="Width" Value="260" />
            <Setter Property="Height" Value="180" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="AllowDrop" Value="True" />
        </Style>
        <!-- Entrée de la liste « Reprendre » : bouton discret, double liseré rouge|bleu (§11.1) -->
        <Style x:Key="RecentEntryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DrawingComparator" ShowMaximize="True" ShowMinimize="True" />

        <!-- ═══ Barre d'outils : groupe projet | calage | export ═══ -->
        <Border Grid.Row="1" Background="{StaticResource BrushSurface}" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}"
                        Margin="0"
                        Command="{Binding OpenAnyCommand}"
                        Content="Ouvrir…"
                        ToolTip="Ouvrir un projet ou un plan PDF (Ctrl+O)" />
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding SaveProjectCommand}"
                        Content="Enregistrer"
                        ToolTip="Enregistrer le projet de superposition (Ctrl+S) — nécessite les deux plans" />
                <Border Width="1"
                        Background="{StaticResource BrushBackground}"
                        Margin="16,2" />
                <Button Style="{StaticResource AccentButton}"
                        Margin="0"
                        Command="{Binding StartAlignmentCommand}"
                        Content="⊕  Caler les plans"
                        ToolTip="Aligner le plan révisé sur le plan de base (A)" />
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding SwapTintsCommand}"
                        Content="⇄"
                        FontSize="{StaticResource FontSizeSubtitle}"
                        MinWidth="40"
                        ToolTip="Permuter les teintes rouge/bleu" />
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ExportCommand}"
                        Content="Exporter PNG"
                        ToolTip="Exporter le comparatif en PNG (Ctrl+E)" />
            </StackPanel>
        </Border>

        <!-- ═══ Zone centrale ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="288" />
            </Grid.ColumnDefinitions>

            <views:ComparatorView Grid.Column="0" DataContext="{Binding}" />

            <!-- État vide : deux zones de dépôt + liste Reprendre (DESIGN_PLAN §3 + §11.1).
                 DUPLIQUÉ VOLONTAIREMENT : les cartes BASE et RÉVISÉ sont jumelles —
                 toute retouche visuelle doit être reportée dans LES DEUX blocs. -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding HasAnyDocument, Converter={StaticResource BoolToCollapsed}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Style="{StaticResource DropCard}"
                            BorderBrush="{StaticResource BrushTintBase}"
                            BorderThickness="3,0,0,0"
                            Drop="OnDropBase"
                            DragOver="OnDragOverFile">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PLAN DE BASE" Style="{StaticResource PanelTitle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Déposer un PDF ici"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4" />
                            <TextBlock Text="teinté rouge"
                                       Foreground="{StaticResource BrushTintBase}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       HorizontalAlignment="Center" />
                            <Button Content="Parcourir…"
                                    Command="{Binding OpenBaseCommand}"
                                    HorizontalAlignment="Center"
                                    MinHeight="32"
                                    Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DropCard}"
                            BorderBrush="{StaticResource BrushTintRevision}"
                            BorderThickness="3,0,0,0"
                            Drop="OnDropRevision"
                            DragOver="OnDragOverFile">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PLAN RÉVISÉ" Style="{StaticResource PanelTitle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Déposer un PDF ici"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4" />
                            <TextBlock Text="teinté bleu"
                                       Foreground="{StaticResource BrushTintRevision}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       HorizontalAlignment="Center" />
                            <Button Content="Parcourir…"
                                    Command="{Binding OpenRevisionCommand}"
                                    HorizontalAlignment="Center"
                                    MinHeight="32"
                                    Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Les traits communs ressortiront sombres, les différences resteront rouges ou bleues."
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="{StaticResource FontSizeBody}"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0" />

                <!-- Reprendre : projets récents (item 2), identité = double liseré rouge|bleu -->
                <StackPanel Margin="16,32,16,0"
                            Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="REPRENDRE" Style="{StaticResource PanelTitle}" Margin="8,0,0,4" />
                    <ItemsControl ItemsSource="{Binding RecentProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RecentEntryButton}"
                                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding ProjectPath}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                            <Border Width="3" Background="{StaticResource BrushTintBase}" />
                                            <Border Width="3" Background="{StaticResource BrushTintRevision}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProjectName}"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PairLabel}"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0" />
                                        <TextBlock Grid.Column="3"
                                                   Style="{StaticResource DataText}"
                                                   Text="{Binding LastOpenedLabel}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Snackbar (item 5) : succès = liseré Accent, échec = liseré Danger -->
            <Border Grid.Column="0"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="24,0,24,24"
                    Background="{StaticResource BrushSurface}"
                    CornerRadius="{StaticResource RadiusCard}"
                    BorderThickness="3,0,0,0"
                    Padding="16,10"
                    Visibility="{Binding SnackbarMessage, Converter={StaticResource NullToCollapsed}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SnackbarIsDanger}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SnackbarMessage}"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center"
                               MaxWidth="520"
                               TextTrimming="CharacterEllipsis" />
                    <Button Content="Ouvrir le dossier"
                            Command="{Binding RevealInExplorerCommand}"
                            MinHeight="28"
                            Margin="12,0,0,0"
                            Visibility="{Binding SnackbarRevealPath, Converter={StaticResource NullToCollapsed}}" />
                    <Button Content="✕"
                            Command="{Binding DismissSnackbarCommand}"
                            MinWidth="28"
                            MinHeight="28"
                            Padding="0"
                            Margin="8,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
            </Border>

            <!-- ═══ Panneau latéral ═══ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="{StaticResource SpaceM}">
                    <TextBlock Text="CALQUES" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />

                    <!-- Carte plan de base.
                         DUPLIQUÉ VOLONTAIREMENT avec la carte plan révisé ci-dessous
                         (2 instances figées par le métier — un UserControl paramétré
                         coûterait plus qu'il ne rapporte) : modifier LES DEUX cartes. -->
                    <Border Style="{StaticResource LayerCard}"
                            BorderBrush="{Binding BaseLayer.Tint, Converter={StaticResource TintToBrush}}"
                            BorderThickness="3,0,0,0"
                            AllowDrop="True"
                            Drop="OnDropBase"
                            DragOver="OnDragOverFile">
                        <StackPanel DataContext="{Binding BaseLayer}">
                            <Grid>
                                <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource PanelTitle}" />
                                <ui:ProgressRing IsIndeterminate="True"
                                                 Width="16" Height="16"
                                                 HorizontalAlignment="Right"
                                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <TextBlock Text="{Binding FileName, TargetNullValue=Aucun fichier}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FilePath}"
                                       Margin="0,8,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Page"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding PageNumbers}"
                                          SelectedItem="{Binding SelectedPage}"
                                          IsEnabled="{Binding HasFile}"
                                          MinHeight="32"
                                          Margin="8,0" />
                                <Button Grid.Column="2"
                                        Content="⋯"
                                        MinWidth="32" MinHeight="32"
                                        ToolTip="Choisir un autre fichier (Ctrl+O)"
                                        Command="{Binding DataContext.OpenBaseCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" />
                                <Button Grid.Column="3"
                                        Content="✕"
                                        MinWidth="32" MinHeight="32"
                                        Margin="4,0,0,0"
                                        IsEnabled="{Binding HasFile}"
                                        ToolTip="Retirer ce plan"
                                        Command="{Binding ClearFileCommand}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacité"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Column="1"
                                        Minimum="0" Maximum="100"
                                        Value="{Binding OpacityPercent}"
                                        IsEnabled="{Binding HasFile}"
                                        Margin="8,0,0,0" />
                            </Grid>
                            <ToggleButton Content="◐ Binariser"
                                          IsChecked="{Binding Binarize}"
                                          IsEnabled="{Binding HasFile}"
                                          MinHeight="28"
                                          HorizontalAlignment="Left"
                                          Margin="0,8,0,0"
                                          ToolTip="Nettoie les scans : fond gris → blanc, traits → teinte pleine. Sans effet sur les PDF vectoriels nets." />
                        </StackPanel>
                    </Border>

                    <!-- Carte plan révisé -->
                    <Border Style="{StaticResource LayerCard}"
                            BorderBrush="{Binding RevisionLayer.Tint, Converter={StaticResource TintToBrush}}"
                            BorderThickness="3,0,0,0"
                            AllowDrop="True"
                            Drop="OnDropRevision"
                            DragOver="OnDragOverFile">
                        <StackPanel DataContext="{Binding RevisionLayer}">
                            <Grid>
                                <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource PanelTitle}" />
                                <ui:ProgressRing IsIndeterminate="True"
                                                 Width="16" Height="16"
                                                 HorizontalAlignment="Right"
                                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <TextBlock Text="{Binding FileName, TargetNullValue=Aucun fichier}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FilePath}"
                                       Margin="0,8,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Page"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding PageNumbers}"
                                          SelectedItem="{Binding SelectedPage}"
                                          IsEnabled="{Binding HasFile}"
                                          MinHeight="32"
                                          Margin="8,0" />
                                <Button Grid.Column="2"
                                        Content="⋯"
                                        MinWidth="32" MinHeight="32"
                                        ToolTip="Choisir un autre fichier (Ctrl+Maj+O)"
                                        Command="{Binding DataContext.OpenRevisionCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" />
                                <Button Grid.Column="3"
                                        Content="✕"
                                        MinWidth="32" MinHeight="32"
                                        Margin="4,0,0,0"
                                        IsEnabled="{Binding HasFile}"
                                        ToolTip="Retirer ce plan"
                                        Command="{Binding ClearFileCommand}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacité"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Column="1"
                                        Minimum="0" Maximum="100"
                                        Value="{Binding OpacityPercent}"
                                        IsEnabled="{Binding HasFile}"
                                        Margin="8,0,0,0" />
                            </Grid>
                            <ToggleButton Content="◐ Binariser"
                                          IsChecked="{Binding Binarize}"
                                          IsEnabled="{Binding HasFile}"
                                          MinHeight="28"
                                          HorizontalAlignment="Left"
                                          Margin="0,8,0,0"
                                          ToolTip="Nettoie les scans : fond gris → blanc, traits → teinte pleine. Sans effet sur les PDF vectoriels nets." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CALAGE" Style="{StaticResource PanelTitle}" Margin="0,8,0,8" />
                    <Border Style="{StaticResource LayerCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DataText}"
                                       Text="{Binding AlignmentSummary, TargetNullValue=non calé}" />
                            <TextBlock Style="{StaticResource DataText}"
                                       Text="{Binding ResidualText}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding ResidualText, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding AnisotropyWarning, StringFormat=⚠ {0}}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding AnisotropyWarning, Converter={StaticResource NullToCollapsed}}" />

                            <!-- Rigide / Affine : opt-in explicite, jamais de bascule silencieuse (SEN-01) -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding CanUseAffine, Converter={StaticResource BoolToVisibility}}">
                                <RadioButton Content="Rigide (2 pts)"
                                             GroupName="AlignMode"
                                             IsChecked="{Binding IsAffineMode, Converter={StaticResource InverseBool}}"
                                             Foreground="{StaticResource BrushTextPrimary}" />
                                <RadioButton Content="Affine (3 pts)"
                                             GroupName="AlignMode"
                                             IsChecked="{Binding IsAffineMode}"
                                             Margin="12,0,0,0"
                                             Foreground="{StaticResource BrushTextPrimary}" />
                            </StackPanel>

                            <!-- AJUSTER : flèches = translation fine du plan RÉVISÉ (item 3),
                                 pas VISIBLE et cliquable — jamais seulement des modificateurs cachés -->
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding HasAlignment, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="AJUSTER (FLÈCHES)" Style="{StaticResource PanelTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="pas"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <RadioButton Content="0,1"
                                                 GroupName="NudgeStep"
                                                 IsChecked="{Binding NudgeStepMm, Converter={StaticResource DoubleEquals}, ConverterParameter=0.1}"
                                                 Foreground="{StaticResource BrushTextPrimary}" />
                                    <RadioButton Content="0,5"
                                                 GroupName="NudgeStep"
                                                 IsChecked="{Binding NudgeStepMm, Converter={StaticResource DoubleEquals}, ConverterParameter=0.5}"
                                                 Margin="8,0,0,0"
                                                 Foreground="{StaticResource BrushTextPrimary}" />
                                    <RadioButton Content="2"
                                                 GroupName="NudgeStep"
                                                 IsChecked="{Binding NudgeStepMm, Converter={StaticResource DoubleEquals}, ConverterParameter=2}"
                                                 Margin="8,0,0,0"
                                                 Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="mm"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Maj = pas fin · Ctrl = pas large · cliquez le plan d'abord"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Content="Réinitialiser"
                                    Command="{Binding ResetAlignmentCommand}"
                                    IsEnabled="{Binding HasAlignment}"
                                    MinHeight="32"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══ Barre de statut ═══ -->
        <Border Grid.Row="3" Background="{StaticResource BrushSurface}" Padding="16,4">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DataText}" Text="{Binding CursorPositionText}" MinWidth="180" />
                    <TextBlock Style="{StaticResource DataText}" Text="  ·  " />
                    <TextBlock Style="{StaticResource DataText}" Text="{Binding ZoomText}" />
                    <TextBlock Style="{StaticResource DataText}" Text="  ·  " />
                    <TextBlock Style="{StaticResource DataText}" Text="{Binding PagesText}" />
                    <!-- FIA-07 : la tuile nette se rend — discret, le document reste roi -->
                    <TextBlock Style="{StaticResource DataText}"
                               Text="  ·  ⟳ netteté…"
                               Visibility="{Binding IsSharpening, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource DataText}"
                           Text="{Binding StatusMessage}"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="620" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
