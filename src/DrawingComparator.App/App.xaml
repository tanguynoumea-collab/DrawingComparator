<Application x:Class="DrawingComparator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DrawingComparator.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
            <local:TintToBrushConverter x:Key="TintToBrush" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:DoubleEqualsConverter x:Key="DoubleEquals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
