<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══ Couleurs (DESIGN_PLAN §2 — thème sombre « négatoscope ») ═══ -->
    <Color x:Key="ColorBackground">#16181D</Color>
    <Color x:Key="ColorSurface">#21242C</Color>
    <Color x:Key="ColorTextPrimary">#E8EAED</Color>
    <Color x:Key="ColorTextSecondary">#9AA0A6</Color>
    <Color x:Key="ColorAccent">#E8B93C</Color>
    <Color x:Key="ColorAccentText">#16181D</Color>
    <Color x:Key="ColorDanger">#E5534B</Color>

    <!-- Couleurs métier : les teintes des plans. Constantes du domaine, pas des couleurs d'interface. -->
    <Color x:Key="ColorTintBase">#D32F2F</Color>
    <Color x:Key="ColorTintRevision">#1E5AC8</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentText" Color="{StaticResource ColorAccentText}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushTintBase" Color="{StaticResource ColorTintBase}" />
    <SolidColorBrush x:Key="BrushTintRevision" Color="{StaticResource ColorTintRevision}" />

    <!-- ═══ Espacement : grille de 4 px ═══ -->
    <Thickness x:Key="SpaceXS">4</Thickness>
    <Thickness x:Key="SpaceS">8</Thickness>
    <Thickness x:Key="SpaceM">16</Thickness>
    <Thickness x:Key="SpaceL">24</Thickness>
    <Thickness x:Key="SpaceXL">32</Thickness>

    <!-- ═══ Typographie ═══ -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeData">13</sys:Double>
    <FontFamily x:Key="FontData">Cascadia Mono, Consolas</FontFamily>

    <!-- ═══ Formes ═══ -->
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>

    <!-- ═══ Styles dérivés ═══ -->
    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <Style x:Key="DataText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontData}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeData}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>
</ResourceDictionary>
